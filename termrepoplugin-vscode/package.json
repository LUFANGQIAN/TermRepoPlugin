{
  "name": "termrepoplugin-vscode",
  "displayName": "TermRepoPlugin-VSCode",
  "description": "一键收藏术语，并通过固定符号快速搜索复用词库单词。",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:termrepoplugin-vscode.addWord",
    "onCommand:termrepoplugin-vscode.showAllWords",
    "onCommand:termrepoplugin-vscode.exportWords",
    "onCommand:termrepoplugin-vscode.importWords",
    "onView:myWebview",
    "onLanguage:*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "termrepo-sidebar-container",
          "title": "TermRepo侧边栏",
          "icon": "$(book)"
        }
      ]
    },
    "views": {
      "termrepo-sidebar-container": [
        {
          "icon": "$(book)",
          "type": "webview",
          "id": "myWebview",
          "name": "词库管理"
        }
      ]
    },
    "commands": [
      {
        "command": "termrepoplugin-vscode.printSelection",
        "title": "打印选中内容",
        "category": "TermRepoPlugin"
      },
      {
        "command": "termrepoplugin-vscode.addWord",
        "title": "收藏选中单词",
        "category": "TermRepoPlugin"
      },
      {
        "command": "termrepoplugin-vscode.showAllWords",
        "title": "显示所有单词",
        "category": "TermRepoPlugin"
      },
      {
        "command": "termrepoplugin-vscode.copyWord",
        "title": "复制单词",
        "category": "TermRepoPlugin"
      },
      {
        "command": "termrepoplugin-vscode.exportWords",
        "title": "导出单词库",
        "category": "TermRepoPlugin"
      },
      {
        "command": "termrepoplugin-vscode.importWords",
        "title": "导入单词库",
        "category": "TermRepoPlugin"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "termrepoplugin-vscode.printSelection",
          "group": "navigation",
          "when": "editorHasSelection"
        },
        {
          "command": "termrepoplugin-vscode.addWord",
          "group": "navigation",
          "when": "editorHasSelection"
        },
        {
          "command": "termrepoplugin-vscode.showAllWords",
          "group": "navigation",
          "when": "true"
        },
        {
          "command": "termrepoplugin-vscode.exportWords",
          "group": "navigation",
          "when": "true"
        },
        {
          "command": "termrepoplugin-vscode.importWords",
          "group": "navigation",
          "when": "true"
        }
      ]
    },
    "keybindings": [
      {
        "command": "termrepoplugin-vscode.addWord",
        "key": "alt+q",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "configuration": {
      "title": "TermRepoPlugin",
      "properties": {
        "termrepoplugin-vscode.triggerSymbol": {
          "type": "string",
          "default": ";",
          "minLength": 1,
          "maxLength": 1,
          "description": "输入该符号后，可从单词库中搜索并替换单词。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "docs": "typedoc --lang zh"
  },
  "devDependencies": {
    "@saber2pr/typedoc-plugin-localization-zh": "^2.3.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.110.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typedoc": "^0.28.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@vscode/webview-ui-toolkit": "^1.4.0"
  }
}
